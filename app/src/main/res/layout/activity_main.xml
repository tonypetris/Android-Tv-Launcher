<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="48dp"
    android:paddingTop="27dp"
    android:paddingRight="48dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFF"
            android:textSize="34sp" />

        <TextClock
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:format12Hour="EEEE d MMMM"
            android:format24Hour="EEEE d MMMM"
            android:textColor="@color/text_dim"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btn_hidden"
            style="@style/TopButton"
            android:text="@string/hidden_apps" />

        <TextView
            android:id="@+id/btn_settings"
            style="@style/TopButton"
            android:layout_marginStart="12dp"
            android:text="@string/settings" />
    </LinearLayout>

    <GridView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="20dp"
        android:clipToPadding="false"
        android:drawSelectorOnTop="true"
        android:horizontalSpacing="16dp"
        android:listSelector="@drawable/focus_border"
        android:numColumns="5"
        android:paddingTop="8dp"
        android:paddingBottom="27dp"
        android:scrollbars="none"
        android:stretchMode="columnWidth"
        android:verticalSpacing="16dp" />
</LinearLayout>
